# ============================================================================
# Variáveis de ambiente — Site Aldifer
#
# Copie para .env e preencha. O .env NUNCA é versionado; este .env.example SIM.
# Na Vercel, cadastre tudo isto no painel do projeto, não no repositório.
#
# Variável que precisa ser lida no navegador exige o prefixo PUBLIC_ (Astro).
# ============================================================================

# --- E-mail transacional (Resend) — Etapa 6 --------------------------------
# Chave da API em https://resend.com/api-keys
RESEND_API_KEY=

# Remetente do e-mail de orçamento. Precisa ser de domínio verificado no Resend,
# com SPF, DKIM e DMARC configurados — sem isso o e-mail cai em spam e a Aldifer
# perde lead sem saber.
QUOTE_MAIL_FROM="Site Aldifer <site@aldifer.com.br>"

# Quem recebe os pedidos de orçamento. [CONFIRMAR COM A ALDIFER]
# Aceita mais de um endereço separado por vírgula.
QUOTE_MAIL_TO=

# --- Anti-spam (Cloudflare Turnstile) — Etapa 6 ----------------------------
# A site key é pública e vai no HTML; a secret é validada no servidor.
PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# --- Persistência do lead — Etapa 6 ----------------------------------------
# E-mail sozinho perde lead. Persistir é obrigatório.
# Driver: json | google-sheets | notion | supabase
# [DECIDIR COM A ALDIFER: o que eles já usam no dia a dia — pergunta 10 da
#  seção 12 do docs/CONTEUDO.md]
LEAD_STORE_DRIVER=json

# Só se LEAD_STORE_DRIVER=json — caminho do arquivo JSONL.
# ATENÇÃO: em ambiente serverless o disco é efêmero e este driver NÃO persiste.
# Ele recusa a gravação e o aviso é carimbado no assunto do e-mail.
LEAD_STORE_FILE=data/leads.jsonl

# Só se LEAD_STORE_DRIVER=google-sheets
GOOGLE_SHEETS_ID=
GOOGLE_SERVICE_ACCOUNT_EMAIL=
GOOGLE_SERVICE_ACCOUNT_PRIVATE_KEY=

# --- CMS Keystatic — Etapa 11 ----------------------------------------------
#
# O painel fica em /keystatic, e /admin redireciona para lá. SEM as variáveis
# abaixo ele roda em modo LOCAL: grava direto no disco, o que é o que se quer
# em desenvolvimento e o que NÃO serve em produção (a Vercel tem disco
# efêmero e somente leitura).
#
# Em produção precisa do modo GitHub, em que cada Save vira um COMMIT no
# repositório. É o que dá histórico, autoria e a possibilidade de desfazer.
#
# PASSO A PASSO, uma vez só:
#   1. Suba o repositório para o GitHub (hoje ele é só local, sem remote).
#   2. Preencha PUBLIC_KEYSTATIC_GITHUB_REPO com "usuario/repositorio".
#   3. Rode o site, abra /keystatic e clique no botão de criar o GitHub App —
#      o próprio Keystatic conduz e devolve as três variáveis seguintes.
#   4. Cadastre as quatro na Vercel e refaça o deploy.
#
# O REPO É PUBLIC_ porque o painel roda no navegador e precisa saber a qual
# repositório pedir. Não é segredo: quem abre o site vê o nome do repositório
# no bundle do painel. Já o CLIENT_SECRET e o KEYSTATIC_SECRET são segredos de
# verdade e ficam só no servidor.
PUBLIC_KEYSTATIC_GITHUB_REPO=

KEYSTATIC_GITHUB_CLIENT_ID=
KEYSTATIC_GITHUB_CLIENT_SECRET=
KEYSTATIC_SECRET=

# --- Analytics sem cookie (Plausible) — Etapa 9 ----------------------------
#
# SEM COOKIE, portanto sem banner de consentimento. A escolha não é estética:
# a Política de Privacidade da Etapa 6 AFIRMA que o site não usa cookie de
# rastreamento, e um banner custaria a primeira interação de todo visitante
# numa página cuja ação primária é montar lista de material. Trocar por Google
# Analytics tornaria aquele texto falso.
#
# Sem a variável abaixo, NENHUM script de analytics é carregado — e o host do
# Plausible também não entra na CSP. As duas coisas vêm da mesma variável, lida
# no astro.config.mjs em tempo de build.
#
# É o domínio cadastrado como propriedade no Plausible, não uma chave secreta.
# [PENDENTE: criar a conta em plausible.io e cadastrar aldifer.com.br]
PUBLIC_PLAUSIBLE_DOMAIN=

# Só para instância auto-hospedada do Plausible. Em branco usa plausible.io.
# ATENÇÃO: mudar isto exige REBUILD, porque o host entra na CSP no build.
PUBLIC_PLAUSIBLE_HOST=

# --- Caixa separada para o formulário de contato — Etapa 8 -----------------
# Opcional. Sem ela, a mensagem de contato cai em QUOTE_MAIL_TO: melhor
# chegar no lugar quase certo que não chegar.
CONTACT_MAIL_TO=
