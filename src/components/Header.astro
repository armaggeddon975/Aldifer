---
import Button from './ui/Button.astro';
import MobileMenu from './MobileMenu.astro';
import Container from './ui/Container.astro';
import { Image } from 'astro:assets';

import marca from '@/assets/aldifer/marca.png';

import Wordmark from './Wordmark.astro';
import { getSite } from '@/lib/site';
import { isActiveRoute, mainNav } from '@/lib/navigation';

const site = await getSite();

// O letreiro é <Wordmark>, com a divisão de cor do logotipo. O comentário que
// vivia aqui dizia "falta o arquivo do logotipo" — e era falso desde a Etapa 8,
// quando o logo.png real foi baixado e passou a gerar os ícones.
const pathname = Astro.url.pathname;
---

<header class="tone-light sticky top-0 z-40 border-b border-surface-border">
  <Container class="flex items-center justify-between gap-4 py-3">
    <a href="/" class="flex items-center gap-3" aria-label={`${site.shortName}, página inicial`}>
      {/*
        O disco da marca, recortado do logo.png pelo `npm run assets`.

        `alt=""` porque ele é DECORATIVO aqui: o nome da empresa já está no
        `aria-label` do link e no letreiro ao lado. Repetir "Aldifer" no alt
        faria o leitor de tela anunciar a marca duas vezes.

        `loading="eager"` porque o padrão do <Image> é lazy, e isto está acima
        da dobra em toda página — adiar traria um pulo de layout logo no topo.

        28px E `densities={[1, 2]}`, e os dois números vêm da fonte: o recorte
        do logo.png tem 58×58, então o 2x de 28 são 56 px — cabem no original.
        Pedir 32px faria o 2x querer 64 e o Astro emitiria só 32, que numa tela
        de alta densidade é ampliação. Medido antes de corrigir: o ativo saía
        com 32×32 naturais.

        `hidden sm:block` porque O CABEÇALHO NÃO CABE COM ELE EM 360px. Medido:
        o disco mais o gap somam 40px, e o grupo da direita — telefone, botão de
        orçamento e menu — passava a terminar em 366px numa viewport de 360. O
        portão `npm run responsivo` reprovou as rotas todas com +6px de scroll
        horizontal.
        
        A alternativa seria tirar o telefone do cabeçalho no mobile, que é uma
        decisão de conversão e não minha. Então em telas pequenas a marca é o
        letreiro de duas cores, que já é o traço mais reconhecível dela; o disco
        entra a partir de 640px, onde sobra espaço.
      */}
      <Image
        src={marca}
        alt=""
        width={28}
        height={28}
        densities={[1, 2]}
        loading="eager"
        class="hidden size-7 shrink-0 sm:block"
      />
      <span class="flex flex-col leading-none">
        <Wordmark class="text-lg" />
        <span class="text-xs text-surface-fg-soft">{site.slogan}</span>
      </span>
    </a>

    <nav aria-label="Navegação principal" class="hidden lg:block">
      <ul class="flex items-center gap-6">
        {
          mainNav.map((item) => {
            const active = isActiveRoute(item.href, pathname);
            return (
              <li>
                <a
                  href={item.href}
                  aria-current={active ? 'page' : undefined}
                  class:list={[
                    'inline-flex items-center border-b-2 py-2 text-base hover:text-surface-hover',
                    active ? 'border-accent font-semibold' : 'border-transparent',
                  ]}
                >
                  {item.label}
                </a>
              </li>
            );
          })
        }
      </ul>
    </nav>

    <div class="flex items-center gap-2">
      <a
        href={`tel:${site.phoneE164}`}
        class="hidden touch-target items-center px-2 font-mono text-sm md:inline-flex hover:text-surface-hover"
      >
        {site.phone}
      </a>

      {/* Ação primária do site: visível em toda largura. O rótulo encurta no
          mobile por <span>, e não por classe `hidden` no próprio Button —
          ver o caveat de conflito de classes em ui/Button.astro. */}
      {/* aria-label explícito: o nome acessível não deve depender de qual
          <span> está visível no breakpoint. "Pedir orçamento" contém o texto
          visível "Orçamento", então atende a WCAG 2.5.3 (Label in Name). */}
      <Button href="/orcamento" aria-label="Pedir orçamento">
        <span class="sm:hidden">Orçamento</span>
        <span class="hidden sm:inline">Pedir orçamento</span>
      </Button>

      <button
        type="button"
        id="menu-open"
        class="touch-target inline-flex items-center justify-center lg:hidden"
        aria-label="Abrir menu de navegação"
      >
        <svg viewBox="0 0 24 24" width="24" height="24" aria-hidden="true" focusable="false">
          <path d="M3 6h18M3 12h18M3 18h18" stroke="currentColor" stroke-width="2" fill="none" />
        </svg>
      </button>
    </div>
  </Container>

  <MobileMenu pathname={pathname} triggerId="menu-open" />
</header>
