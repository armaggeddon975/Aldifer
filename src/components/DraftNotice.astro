---
import { SHOW_DRAFTS } from '@/lib/products';

/**
 * Aviso de conteúdo em conferência.
 *
 * APARECE EM PRODUÇÃO TAMBÉM, desde 07/09/2026. Antes disso este comentário
 * dizia "aparece SÓ em desenvolvimento" e o texto visível afirmava "visível
 * apenas em desenvolvimento" — as duas coisas deixaram de ser verdade quando a
 * chave `SHOW_DRAFTS` passou a publicar os rascunhos para a revisão do site.
 * Ver a nota em `src/lib/products.ts`.
 *
 * O texto se ADAPTA ao ambiente por isso: um aviso que mente sobre onde está
 * sendo lido não serve para nada. Em desenvolvimento ele diz que os rascunhos
 * ficam fora do build; em produção, que o catálogo está em revisão e as bitolas
 * não foram confirmadas — que é a informação de que quem estiver revisando
 * precisa.
 *
 * Sobre o `⚠`: o CLAUDE.md proíbe emoji no site, e o texto deste aviso está
 * especificado com o símbolo na seção 4 do docs/CONTEUDO.md. A justificativa
 * anterior era que o componente nunca chegava ao público, e ela caiu junto com
 * o resto. A que vale agora: este aviso é instrumentação de REVISÃO e sai do ar
 * junto com a chave `SHOW_DRAFTS`, antes de o domínio ser apontado — está no
 * bloco de pendências bloqueantes do README. Se por algum motivo o site for ao
 * ar com rascunhos, o símbolo é o menor dos problemas.
 */
interface Props {
  /** O que precisa de conferência. Aparece na segunda linha. */
  detail?: string;
}

const { detail }: Props = Astro.props;
---

{
  SHOW_DRAFTS && (
    <aside role="note" class="draft-notice">
      <p class="draft-notice__headline">
        ⚠ Tabela em conferência — validar com a Aldifer antes de publicar
      </p>
      {detail && <p class="draft-notice__detail">{detail}</p>}
      <p class="draft-notice__meta">
        {
          import.meta.env.DEV
            ? 'Visível apenas em desenvolvimento. Produtos em rascunho são excluídos do build de produção.'
            : 'Catálogo em REVISÃO: os produtos em rascunho estão publicados de propósito, pela chave SHOW_DRAFTS. As bitolas são faixa comercial padrão de mercado e ainda não foram confirmadas pela Aldifer.'
        }
      </p>
    </aside>
  )
}

<style>
  .draft-notice {
    border: 2px solid var(--accent);
    border-left-width: 6px;
    background-color: var(--paper-alt);
    color: var(--ink);
    padding: var(--space-12) var(--space-16);
    margin-block: var(--space-16);
  }

  .draft-notice__headline {
    font-weight: 600;
    font-size: var(--size-sm);
  }

  .draft-notice__detail {
    margin-top: var(--space-8);
    font-size: var(--size-sm);
    color: var(--ink-soft);
  }

  .draft-notice__meta {
    margin-top: var(--space-8);
    font-family: var(--family-mono);
    font-size: var(--size-xs);
    color: var(--ink-soft);
  }
</style>
