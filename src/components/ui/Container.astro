---
/**
 * Largura máxima e recuo lateral consistentes em todo o site.
 * Recuo: 16px no mobile, 24px em tablet, 32px em desktop — todos na escala.
 */
interface Props {
  as?: 'div' | 'header' | 'footer' | 'nav' | 'section';
  class?: string;
}

// Anotação explícita: aqui o Astro só leria `Props` de forma implícita, e o
// TypeScript acusaria a interface como não usada.
const { as: Tag = 'div', class: className }: Props = Astro.props;
---

<Tag class:list={['mx-auto w-full max-w-content px-4 md:px-6 lg:px-8', className]}>
  <slot />
</Tag>
