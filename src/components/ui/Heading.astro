---
/**
 * Título na escala tipográfica do design system, em Archivo Expanded.
 *
 * `level` é a semântica (nunca pule nível) e `size` é a aparência. Separá-los
 * permite que um h3 pareça pequeno sem quebrar a hierarquia do documento —
 * é o que evita a tentação de escolher a tag pelo tamanho.
 */
export type HeadingLevel = 1 | 2 | 3 | 4;

interface Props {
  level: HeadingLevel;
  size?: HeadingLevel;
  id?: string;
  class?: string;
  /** Cor de apoio, para subtítulos dentro de um bloco. */
  soft?: boolean;
}

const { level, size = level, id, class: className, soft = false } = Astro.props;

const Tag = `h${level}` as 'h1' | 'h2' | 'h3' | 'h4';

// 34/46/62 · 26/34 · 20/26 · 16/20
const SIZE: Record<HeadingLevel, string> = {
  1: 'text-2xl md:text-3xl lg:text-4xl font-bold',
  2: 'text-xl md:text-2xl font-bold',
  3: 'text-lg md:text-xl font-semibold',
  4: 'text-base md:text-lg font-semibold',
};
---

<Tag
  id={id}
  class:list={[
    'display-expanded text-balance',
    SIZE[size],
    soft ? 'text-surface-fg-soft' : 'text-surface-fg',
    className,
  ]}
>
  <slot />
</Tag>
