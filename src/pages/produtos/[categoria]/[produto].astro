---
import type { GetStaticPaths } from 'astro';
import { render } from 'astro:content';

import Breadcrumb from '@/components/catalog/Breadcrumb.astro';
import GaugeTable from '@/components/catalog/GaugeTable.astro';
import CrossSection from '@/components/CrossSection.astro';
import DraftNotice from '@/components/DraftNotice.astro';
import Button from '@/components/ui/Button.astro';
import Heading from '@/components/ui/Heading.astro';
import Section from '@/components/ui/Section.astro';
import Base from '@/layouts/Base.astro';
import { breadcrumb, productPage } from '@/lib/catalog-content';
import { buildLegend } from '@/lib/cross-section-legend';
import { getVisibleCategories, getVisibleProducts, isDraft } from '@/lib/products';

/**
 * Página de produto — a mais importante do site.
 *
 * A ordem das seções é a do PROMPTS.md: trilha, H1, desenho grande com as
 * cotas, descrição e aplicações, TABELA DE BITOLAS, acabamentos, CTA de
 * orçamento e link para a calculadora.
 *
 * Em produção esta rota não gera nenhuma página enquanto os 27 produtos
 * estiverem em rascunho. É intencional — ver a seção bloqueante do README.
 */
export const getStaticPaths = (async () => {
  const [products, categories] = await Promise.all([getVisibleProducts(), getVisibleCategories()]);
  const categoryName = new Map(categories.map((category) => [category.id, category.data.name]));

  return products.map((product) => ({
    params: { categoria: product.data.category, produto: product.id },
    props: {
      product,
      categoryLabel: categoryName.get(product.data.category) ?? product.data.category,
    },
  }));
}) satisfies GetStaticPaths;

const { product, categoryLabel } = Astro.props;
const { Content } = await render(product);

const { name, crossSection, applications, finishes, dimensionColumns } = product.data;

/** Liga as letras do desenho às colunas da tabela. */
const legend = buildLegend(crossSection, dimensionColumns);

/**
 * A calculadora recebe o SLUG do produto, e não o id da fórmula: a URL fica em
 * português e compartilhável, e a Etapa 7 resolve produto -> fórmula.
 * Produto sem fórmula não ganha o link.
 */
const calculatorHref = product.data.weightFormula
  ? `/calculadora-de-peso?produto=${product.id}`
  : null;
---

<Base title={product.data.seoTitle} description={product.data.seoDescription}>
  <Section tone="light" spacing="md" labelledBy="produto">
    <Breadcrumb
      items={[
        { label: breadcrumb.catalogLabel, href: '/produtos' },
        { label: categoryLabel, href: `/produtos/${product.data.category}` },
        { label: name },
      ]}
    />

    <div class="mt-6 grid gap-10 lg:grid-cols-[1fr_20rem] lg:items-start lg:gap-16">
      <div>
        <Heading level={1} id="produto">{name}</Heading>
        <p class="mt-4 max-w-2xl text-lg text-surface-fg-soft">{product.data.shortDescription}</p>

        <div class="prose-aldifer mt-8 max-w-2xl">
          <Content />
        </div>

        {
          applications.length > 0 && (
            <div class="mt-8">
              <Heading level={2} size={4}>{productPage.applicationsHeading}</Heading>
              <ul class="mt-3 flex flex-wrap gap-x-4 gap-y-2 text-sm text-surface-fg-soft">
                {applications.map((application) => (
                  <li class="border-l-2 border-surface-border pl-3">{application}</li>
                ))}
              </ul>
            </div>
          )
        }
      </div>

      {/* Desenho grande, COM cotas, e a legenda que liga cada letra à coluna
          correspondente da tabela abaixo. */}
      {
        crossSection && (
          <figure class="border border-surface-border p-4">
            <div class="text-surface-fg">
              <CrossSection variant={crossSection} />
            </div>
            {legend.length > 0 && (
              <figcaption class="mt-4 border-t border-surface-border pt-4">
                <p class="text-xs font-semibold text-surface-fg">{productPage.legendHeading}</p>
                <dl class="mt-2 flex flex-col gap-1 text-sm">
                  {legend.map((entry) => (
                    <div class="flex gap-3">
                      <dt class="w-6 shrink-0 font-mono font-semibold">{entry.letter}</dt>
                      <dd class="text-surface-fg-soft">{entry.label}</dd>
                    </div>
                  ))}
                </dl>
              </figcaption>
            )}
          </figure>
        )
      }
    </div>
  </Section>

  <Section tone="alt" spacing="md" labelledBy="bitolas">
    <Heading level={2} id="bitolas">{productPage.gaugeHeading}</Heading>

    {isDraft(product) && <DraftNotice detail={`Produto: ${name}.`} />}

    <div class="mt-6">
      <GaugeTable product={product} />
    </div>

    <div class="mt-10 flex flex-col gap-8 md:flex-row md:justify-between">
      {
        finishes.length > 0 && (
          <div>
            <Heading level={2} size={4}>{productPage.finishesHeading}</Heading>
            <ul class="mt-3 flex flex-wrap gap-x-4 gap-y-2 text-sm text-surface-fg-soft">
              {finishes.map((finish) => (
                <li class="border-l-2 border-surface-border pl-3">{finish}</li>
              ))}
            </ul>
          </div>
        )
      }

      {
        calculatorHref && (
          <div class="md:text-right">
            <Button href={calculatorHref} variant="secondary">
              {productPage.calculatorLabel}
            </Button>
          </div>
        )
      }
    </div>
  </Section>

  <Section tone="dark" spacing="md" labelledBy="pedir">
    <div class="max-w-2xl">
      <Heading level={2} id="pedir">{productPage.quoteCtaHeading}</Heading>
      <p class="mt-4 text-surface-fg-soft">{productPage.quoteCtaBody}</p>
      <div class="mt-8 flex flex-wrap gap-4">
        <Button href="/orcamento" size="lg">{productPage.quoteCtaLabel}</Button>
        <Button href="/produtos" variant="ghost">Voltar ao catálogo</Button>
      </div>
    </div>
  </Section>
</Base>
