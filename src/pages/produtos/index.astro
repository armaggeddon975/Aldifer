---
import Breadcrumb from '@/components/catalog/Breadcrumb.astro';
import CatalogFilter from '@/components/catalog/CatalogFilter.astro';
import DraftNotice from '@/components/DraftNotice.astro';
import JsonLd from '@/components/JsonLd.astro';
import Heading from '@/components/ui/Heading.astro';
import Section from '@/components/ui/Section.astro';
import Base from '@/layouts/Base.astro';
import { breadcrumb, catalogPage } from '@/lib/catalog-content';
import { categoryHref, getVisibleCategories, getVisibleProducts, isDraft } from '@/lib/products';
import { itemListJsonLd } from '@/lib/structured-data';

/**
 * Catálogo completo, com filtro.
 *
 * Title e description vêm da linha "Produtos" da seção 10 do
 * docs/CONTEUDO.md.
 */
const products = await getVisibleProducts();
const categories = await getVisibleCategories();
const draftCount = products.filter(isDraft).length;

const base = Astro.site ?? new URL('/', Astro.url);

/**
 * ItemList das seis CATEGORIAS, e não dos produtos.
 *
 * Nesta página o que o visitante escolhe é a categoria; a lista de produtos
 * vive atrás do filtro e muda com ele. Uma ItemList de 27 produtos aqui
 * descreveria algo que a página não mostra de uma vez, e as páginas de
 * categoria já listam os produtos delas.
 */
const listaJsonLd = itemListJsonLd(
  categories.map((category) => ({
    name: category.data.name,
    description: category.data.shortDescription,
    url: new URL(categoryHref(category.id), base).href,
  })),
  catalogPage.heading,
);
---

<Base title={catalogPage.seoTitle} description={catalogPage.seoDescription}>
  <JsonLd slot="jsonld" data={listaJsonLd} />

  <Section tone="light" spacing="md" labelledBy="catalogo">
    <Breadcrumb items={[{ label: breadcrumb.catalogLabel }]} />

    <div class="mt-6">
      <Heading level={1} id="catalogo">{catalogPage.heading}</Heading>
      <p class="mt-4 max-w-2xl text-surface-fg-soft">{catalogPage.description}</p>
    </div>

    {
      draftCount > 0 && (
        <DraftNotice
          detail={`${draftCount} de ${products.length} produtos estão em rascunho. As bitolas são faixa comercial padrão de mercado, não o estoque real da Aldifer.`}
        />
      )
    }

    <div class="mt-10">
      <CatalogFilter products={products} categories={categories} />
    </div>
  </Section>
</Base>
