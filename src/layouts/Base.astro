---
import '@/styles/global.css';
import Header from '@/components/Header.astro';
import Footer from '@/components/Footer.astro';
import JsonLd from '@/components/JsonLd.astro';
import NoticeBar from '@/components/NoticeBar.astro';
import QuoteBar from '@/components/QuoteBar.astro';
import Analytics from '@/components/Analytics.astro';
import { getSite } from '@/lib/site';
import { QUOTE_BOOT } from '@/lib/quote-boot.mjs';
import { businessJsonLd } from '@/lib/structured-data';

const site = await getSite();

interface Props {
  title: string;
  description: string;
  /** Absoluta. Se omitida, é derivada de `site` no astro.config e do caminho. */
  canonical?: string;
  /**
   * Imagem de compartilhamento. O padrão serve a TODA página: card social sem
   * imagem vira um retângulo cinza com o domínio, e o link deixa de convidar
   * ao clique no WhatsApp, que é por onde o serralheiro manda coisa.
   *
   * Gerada por `npm run assets`, do logotipo real e da foto do estoque.
   */
  ogImage?: string;
  noindex?: boolean;
}

const OG_PADRAO = '/og-image.jpg';

const {
  title,
  description,
  canonical,
  ogImage = OG_PADRAO,
  noindex = false,
} = Astro.props;

const canonicalUrl = canonical ?? new URL(Astro.url.pathname, Astro.site ?? Astro.url).href;
---

<html lang="pt-BR">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />

    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalUrl} />
    {noindex && <meta name="robots" content="noindex, nofollow" />}

    {/* Preload SÓ da Archivo: é a fonte do H1, que é o elemento de LCP.
        Precarregar as três disputaria banda com o próprio conteúdo. */}
    <link
      rel="preload"
      href="/fonts/archivo-latin-expanded-normal.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />

    {/* Ícones gerados do logotipo real da Aldifer por `npm run assets`. Até a
        Etapa 8 aqui estava o favicon PADRÃO DO ASTRO, que teria ido ao ar no
        site do cliente. */}
    {/*
      Decide o estado da lista de orçamento ANTES DA PRIMEIRA PINTURA.

      SÍNCRONO e no <head> de propósito: é o que evita o formulário de
      /orcamento aparecer e colapsar quando o script de hidratação descobre
      que a lista está vazia — o Lighthouse media CLS de até 0,332 ali.

      `is:inline` para o Astro não o transformar em módulo (módulo é diferido
      e chegaria tarde). O hash dele entra na CSP em astro.config.mjs,
      calculado da mesma constante. Ver src/lib/quote-boot.mjs.
    */}
    <script is:inline set:html={QUOTE_BOOT} />

    <link rel="icon" href="/favicon.ico" sizes="16x16 32x32 48x48" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/manifest.webmanifest" />
    <meta name="theme-color" content="#0B1B2E" />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={site.legalName} />
    <meta property="og:locale" content="pt_BR" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:image" content={new URL(ogImage, Astro.site ?? Astro.url).href} />
    <meta property="og:image:alt" content={`${site.legalName} — ${site.slogan}`} />
    {/* Dimensões só na imagem padrão, cujo tamanho eu conheço: declarar
        1200×630 para uma imagem de outro tamanho faz o WhatsApp reservar a
        proporção errada e cortar o card. */}
    {
      ogImage === OG_PADRAO && (
        <>
          <meta property="og:image:width" content="1200" />
          <meta property="og:image:height" content="630" />
        </>
      )
    }
    <meta name="twitter:card" content="summary_large_image" />

    {/*
      A empresa, em toda página.

      SÓ COM DADO CONFIRMADO: horário e coordenada são omitidos porque a
      Aldifer ainda não os confirmou. JSON-LD é o que o Google lê como
      declaração formal do negócio — horário inventado sai no resultado de
      busca como se a empresa o tivesse afirmado, e quem chega no galpão
      fechado culpa a Aldifer. Ver src/lib/structured-data.ts.
    */}
    <JsonLd data={businessJsonLd(site, new URL('/', Astro.site ?? Astro.url))} />

    {/* Breadcrumb, ItemList e o que mais a página tiver. */}
    <slot name="jsonld" />
  </head>

  <body>
    {/* PRIMEIRO elemento focável da página. */}
    <a href="#conteudo" class="skip-link">Pular para o conteúdo</a>

    {/* Antes do cabeçalho: um aviso de recesso precisa ser a primeira coisa
        lida, e depois do header ele passaria batido em quem já rolou. */}
    <NoticeBar />

    <Header />

    {/* tabindex="-1" é o que faz o foco realmente ir para cá ao usar o atalho:
        sem ele o navegador rola a página mas deixa o foco onde estava. */}
    <main id="conteudo" tabindex="-1">
      <slot />
    </main>

    <Footer />

    {/* Analytics sem cookie. Não renderiza nada sem PUBLIC_PLAUSIBLE_DOMAIN. */}
    <Analytics />

    {/* Única ilha global do site. Fica escondida até haver 1 medida na lista,
        e ao aparecer reserva o próprio espaço no fim da página. */}
    <QuoteBar />
  </body>
</html>
